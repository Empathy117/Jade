{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/contracts/v1/library.schema.json",
  "title": "Reader book library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "books"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/book"
      }
    }
  },
  "$defs": {
    "bookId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "book_id",
        "path",
        "title",
        "author",
        "summary",
        "cover",
        "source_revision",
        "paragraph_count",
        "production"
      ],
      "properties": {
        "book_id": {
          "$ref": "#/$defs/bookId"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": ["string", "null"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "cover": {
          "$ref": "#/$defs/relativePath"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "paragraph_count": {
          "type": "integer",
          "minimum": 1
        },
        "production": {
          "enum": ["manual", "agent-assisted", "automated"]
        }
      }
    }
  }
}
