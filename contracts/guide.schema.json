{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/contracts/v1/guide.schema.json",
  "title": "Optional reader guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "source_revision",
    "source_sha256"
  ],
  "anyOf": [
    { "required": ["start_at"] },
    { "required": ["references"] }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "book_id": {
      "$ref": "#/$defs/bookId"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "start_at": {
      "$ref": "#/$defs/paragraphId"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "bookId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paragraphId": {
      "type": "string",
      "pattern": "^p[0-9]{4,}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "illustration_id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ref_[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "illustration_id": {
          "type": "string",
          "pattern": "^ill[0-9]{4,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
