{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/contracts/v1/assets.schema.json",
  "title": "Asset catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "assets"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "assets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/backgroundAsset"
          },
          {
            "$ref": "#/$defs/musicAsset"
          },
          {
            "$ref": "#/$defs/ambienceAsset"
          }
        ]
      }
    }
  },
  "$defs": {
    "assetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "assetBase": {
      "type": "object",
      "required": [
        "id",
        "type",
        "path",
        "tags",
        "license",
        "source",
        "attribution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/assetId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["background", "music", "ambience"]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": ["string", "null"]
        }
      }
    },
    "backgroundAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "background"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "musicAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "required": ["type", "loop"],
          "properties": {
            "type": {
              "const": "music"
            },
            "loop": {
              "type": "boolean"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ambienceAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "required": ["type", "loop"],
          "properties": {
            "type": {
              "const": "ambience"
            },
            "loop": {
              "type": "boolean"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
