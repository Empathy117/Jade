{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/contracts/v1/direction.schema.json",
  "title": "Semantic scene direction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "source_revision",
    "source_sha256",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "book_id": {
      "$ref": "#/$defs/bookId"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "bookId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paragraphId": {
      "type": "string",
      "pattern": "^p[0-9]{4,}$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^scene_[0-9]{3,}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "tagList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "location",
        "time",
        "weather",
        "mood",
        "tension",
        "background",
        "music",
        "ambience"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sceneId"
        },
        "start": {
          "$ref": "#/$defs/paragraphId"
        },
        "end": {
          "$ref": "#/$defs/paragraphId"
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/tag"
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "oneOf": [
            {
              "$ref": "#/$defs/tag"
            },
            {
              "type": "null"
            }
          ]
        },
        "weather": {
          "oneOf": [
            {
              "$ref": "#/$defs/tag"
            },
            {
              "type": "null"
            }
          ]
        },
        "mood": {
          "allOf": [
            {
              "$ref": "#/$defs/tagList"
            },
            {
              "minItems": 1,
              "maxItems": 5
            }
          ]
        },
        "tension": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags"],
          "properties": {
            "tags": {
              "$ref": "#/$defs/tagList"
            }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags", "intensity"],
          "properties": {
            "tags": {
              "$ref": "#/$defs/tagList"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "ambience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags"],
          "properties": {
            "tags": {
              "$ref": "#/$defs/tagList"
            }
          }
        }
      }
    }
  }
}
