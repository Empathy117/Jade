{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/contracts/v1/direction.schema.json",
  "title": "Semantic scene direction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "source_revision",
    "source_sha256",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "book_id": {
      "$ref": "#/$defs/bookId"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "grades": {
      "type": "object",
      "maxProperties": 5,
      "propertyNames": {
        "$ref": "#/$defs/tag"
      },
      "additionalProperties": {
        "$ref": "#/$defs/grade"
      }
    },
    "moments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moment"
      }
    },
    "profile": {
      "enum": ["immersive", "visual_novel"]
    },
    "sounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sound"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "cgs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cg"
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instrument"
      }
    },
    "gestures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gesture"
      }
    }
  },
  "$defs": {
    "bookId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paragraphId": {
      "type": "string",
      "pattern": "^p[0-9]{4,}$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^scene_[0-9]{3,}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "tagList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "location",
        "time",
        "weather",
        "mood",
        "tension",
        "background",
        "music",
        "ambience"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sceneId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/paragraphId"
        },
        "end": {
          "$ref": "#/$defs/paragraphId"
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/tag"
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "oneOf": [
            {
              "$ref": "#/$defs/tag"
            },
            {
              "type": "null"
            }
          ]
        },
        "weather": {
          "oneOf": [
            {
              "$ref": "#/$defs/tag"
            },
            {
              "type": "null"
            }
          ]
        },
        "mood": {
          "allOf": [
            {
              "$ref": "#/$defs/tagList"
            },
            {
              "minItems": 1,
              "maxItems": 5
            }
          ]
        },
        "tension": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags"],
          "properties": {
            "tags": {
              "$ref": "#/$defs/tagList"
            }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags", "intensity"],
          "properties": {
            "tags": {
              "$ref": "#/$defs/tagList"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "ambience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags"],
          "properties": {
            "tags": {
              "$ref": "#/$defs/tagList"
            }
          }
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shot"
          }
        },
        "grade": {
          "$ref": "#/$defs/tag"
        },
        "layout": {
          "enum": ["nvl", "adv"]
        },
        "atmosphere": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "particles": {
              "enum": ["dust"]
            },
            "flicker": {
              "enum": ["faint", "unsteady"]
            }
          }
        }
      }
    },
    "momentId": {
      "type": "string",
      "pattern": "^moment_[0-9]{3,}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tint", "shade", "saturation"],
      "properties": {
        "tint": {
          "$ref": "#/$defs/color"
        },
        "shade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "framing", "move"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "framing": {
          "enum": ["wide", "medium", "close", "detail"]
        },
        "move": {
          "enum": [
            "hold",
            "drift",
            "push_in",
            "pull_out",
            "pan_left",
            "pan_right",
            "rack_focus"
          ]
        },
        "focus": {
          "$ref": "#/$defs/tag"
        }
      }
    },
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "template", "intent"],
      "properties": {
        "id": {
          "$ref": "#/$defs/momentId"
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "template": {
          "enum": [
            "letterbox_hold",
            "isolate_line",
            "silence",
            "grade_shift",
            "flash_cut",
            "slow_reveal"
          ]
        },
        "intent": {
          "$ref": "#/$defs/tag"
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2500
        },
        "grade": {
          "$ref": "#/$defs/tag"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "template": {
                "const": "grade_shift"
              }
            }
          },
          "then": {
            "required": ["grade"]
          }
        }
      ]
    },
    "soundId": {
      "type": "string",
      "pattern": "^sound_[0-9]{3,}$"
    },
    "cgId": {
      "type": "string",
      "pattern": "^cg_[0-9]{3,}$"
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "tags", "intent"],
      "properties": {
        "id": {
          "$ref": "#/$defs/soundId"
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "allOf": [
            {
              "$ref": "#/$defs/tagList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "intent": {
          "$ref": "#/$defs/tag"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "type", "strength"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": ["shake", "pulse", "tremble"]
        },
        "strength": {
          "enum": ["light", "medium", "strong"]
        }
      }
    },
    "cg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "until", "tags", "intent"],
      "properties": {
        "id": {
          "$ref": "#/$defs/cgId"
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "until": {
          "$ref": "#/$defs/paragraphId"
        },
        "until_beat": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "allOf": [
            {
              "$ref": "#/$defs/tagList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "intent": {
          "$ref": "#/$defs/tag"
        }
      }
    },
    "instrumentId": {
      "type": "string",
      "pattern": "^instrument_[0-9]{3,}$"
    },
    "instrumentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "state"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "anyOf": [
            { "$ref": "#/$defs/radioState" },
            { "$ref": "#/$defs/windState" },
            { "$ref": "#/$defs/letterState" },
            { "$ref": "#/$defs/pianolaState" }
          ]
        }
      }
    },
    "radioState": {
      "enum": ["off", "listening", "tuning", "contact", "transmitting", "lost"]
    },
    "windState": {
      "enum": ["calm", "breeze", "wind", "gale", "storm"]
    },
    "letterState": {
      "enum": ["sealed", "reading", "faltering", "set_down"]
    },
    "pianolaState": {
      "enum": ["closed", "playing", "faltering", "dismantled"]
    },
    "letterExtent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "until"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "until": {
          "$ref": "#/$defs/paragraphId"
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "at", "until", "intent", "states"],
      "properties": {
        "id": {
          "$ref": "#/$defs/instrumentId"
        },
        "kind": {
          "enum": ["radio", "wind", "letter", "pianola"]
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "until": {
          "$ref": "#/$defs/paragraphId"
        },
        "until_beat": {
          "type": "integer",
          "minimum": 0
        },
        "intent": {
          "$ref": "#/$defs/tag"
        },
        "extent": {
          "$ref": "#/$defs/letterExtent"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instrumentState"
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "radio" } } },
          "then": {
            "properties": {
              "states": { "items": { "properties": { "state": { "$ref": "#/$defs/radioState" } } } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "wind" } } },
          "then": {
            "properties": {
              "states": { "items": { "properties": { "state": { "$ref": "#/$defs/windState" } } } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "letter" } } },
          "then": {
            "properties": {
              "states": { "items": { "properties": { "state": { "$ref": "#/$defs/letterState" } } } }
            }
          },
          "else": { "not": { "required": ["extent"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "pianola" } } },
          "then": {
            "properties": {
              "states": { "items": { "properties": { "state": { "$ref": "#/$defs/pianolaState" } } } }
            }
          }
        }
      ]
    },
    "gestureId": {
      "type": "string",
      "pattern": "^gesture_[0-9]{3,}$"
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "at", "intent"],
      "properties": {
        "id": {
          "$ref": "#/$defs/gestureId"
        },
        "kind": {
          "enum": ["grind_ink", "press_seal"]
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "intent": {
          "$ref": "#/$defs/tag"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["grades"]
            },
            {
              "required": ["moments"]
            },
            {
              "required": ["profile"]
            },
            {
              "required": ["sounds"]
            },
            {
              "required": ["effects"]
            },
            {
              "required": ["cgs"]
            },
            {
              "required": ["instruments"]
            },
            {
              "required": ["gestures"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "scenes": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": ["shots"]
                  },
                  {
                    "required": ["grade"]
                  },
                  {
                    "required": ["layout"]
                  },
                  {
                    "required": ["atmosphere"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
