{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive-reader.local/contracts/v1/playback.schema.json",
  "title": "Resolved Reader playback cues",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "source_revision",
    "source_sha256",
    "asset_catalog_id",
    "cues"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "book_id": {
      "$ref": "#/$defs/bookId"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "asset_catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    },
    "camera": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cameraKey"
      }
    },
    "moments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/momentCue"
      }
    },
    "sounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/soundCue"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effectCue"
      }
    },
    "cgs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cgCue"
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instrumentCue"
      }
    },
    "gestures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gestureCue"
      }
    }
  },
  "$defs": {
    "bookId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paragraphId": {
      "type": "string",
      "pattern": "^p[0-9]{4,}$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^scene_[0-9]{3,}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "transition": {
      "enum": ["cut", "crossfade", "iris", "wipe"]
    },
    "backgroundState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "transition", "duration_ms"],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "musicState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "transition", "duration_ms", "gain"],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ambienceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "gain"],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "scene_id"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "scene_id": {
          "$ref": "#/$defs/sceneId"
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/backgroundState"
            },
            {
              "type": "null"
            }
          ]
        },
        "music": {
          "oneOf": [
            {
              "$ref": "#/$defs/musicState"
            },
            {
              "type": "null"
            }
          ]
        },
        "ambience": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ambienceState"
          }
        },
        "clear_text": {
          "type": "boolean"
        },
        "grade": {
          "$ref": "#/$defs/gradeState"
        },
        "layout": {
          "enum": ["nvl", "adv"]
        },
        "atmosphere": {
          "$ref": "#/$defs/atmosphereState"
        }
      },
      "anyOf": [
        {
          "required": ["background"]
        },
        {
          "required": ["music"]
        },
        {
          "required": ["ambience"]
        },
        {
          "required": ["clear_text"]
        },
        {
          "required": ["grade"]
        },
        {
          "required": ["layout"]
        },
        {
          "required": ["atmosphere"]
        }
      ]
    },
    "unit": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "momentId": {
      "type": "string",
      "pattern": "^moment_[0-9]{3,}$"
    },
    "cameraKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "scale", "x", "y"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "x": {
          "$ref": "#/$defs/unit"
        },
        "y": {
          "$ref": "#/$defs/unit"
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "drift": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.02
        }
      }
    },
    "gradeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tint", "shade", "saturation", "duration_ms"],
      "properties": {
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "shade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "momentCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "template", "params"],
      "properties": {
        "id": {
          "$ref": "#/$defs/momentId"
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "template": {
          "enum": [
            "letterbox_hold",
            "isolate_line",
            "silence",
            "grade_shift",
            "flash_cut",
            "slow_reveal"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "out_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "hold_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2500
            },
            "dim": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blur_px": {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "letterbox": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.25
            },
            "flash": {
              "enum": ["white", "black"]
            },
            "music_gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grade": {
              "$ref": "#/$defs/gradeState"
            },
            "hide_chrome": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "soundId": {
      "type": "string",
      "pattern": "^sound_[0-9]{3,}$"
    },
    "cgId": {
      "type": "string",
      "pattern": "^cg_[0-9]{3,}$"
    },
    "soundCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "asset_id", "gain"],
      "properties": {
        "id": {
          "$ref": "#/$defs/soundId"
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "effectCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "type", "intensity"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": ["shake", "pulse", "tremble"]
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "cgCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "until", "asset_id", "transition", "duration_ms"],
      "properties": {
        "id": {
          "$ref": "#/$defs/cgId"
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "until": {
          "$ref": "#/$defs/paragraphId"
        },
        "until_beat": {
          "type": "integer",
          "minimum": 0
        },
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "atmosphereState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["particles", "density", "flicker"],
      "properties": {
        "particles": {
          "oneOf": [
            {
              "enum": ["dust"]
            },
            {
              "type": "null"
            }
          ]
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flicker": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "instrumentId": {
      "type": "string",
      "pattern": "^instrument_[0-9]{3,}$"
    },
    "radioKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "state", "signal", "noise", "tx"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": ["off", "listening", "tuning", "contact", "transmitting", "lost"]
        },
        "frequency": {
          "type": "string",
          "pattern": "^[0-9]{1,5}(\\.[0-9]{1,3}){0,2}$"
        },
        "signal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "noise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tx": {
          "type": "boolean"
        },
        "tuning": {
          "type": "boolean"
        }
      }
    },
    "windKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "state", "strength", "gust"],
      "properties": {
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": ["calm", "breeze", "wind", "gale", "storm"]
        },
        "from": {
          "enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw"]
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gust": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "if": { "properties": { "state": { "const": "calm" } } },
      "then": { "not": { "required": ["from"] } }
    },
    "instrumentCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "at", "until", "placement", "keys"],
      "properties": {
        "id": {
          "$ref": "#/$defs/instrumentId"
        },
        "kind": {
          "enum": ["radio", "wind"]
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "until": {
          "$ref": "#/$defs/paragraphId"
        },
        "until_beat": {
          "type": "integer",
          "minimum": 0
        },
        "placement": {
          "enum": ["auto", "top_right", "above_text"]
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "radio" } } },
          "then": { "properties": { "keys": { "items": { "$ref": "#/$defs/radioKey" } } } }
        },
        {
          "if": { "properties": { "kind": { "const": "wind" } } },
          "then": { "properties": { "keys": { "items": { "$ref": "#/$defs/windKey" } } } }
        }
      ]
    },
    "gestureId": {
      "type": "string",
      "pattern": "^gesture_[0-9]{3,}$"
    },
    "gestureCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "at", "placement", "params"],
      "properties": {
        "id": {
          "$ref": "#/$defs/gestureId"
        },
        "kind": {
          "enum": ["grind_ink", "press_seal"]
        },
        "at": {
          "$ref": "#/$defs/paragraphId"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "placement": {
          "enum": ["auto", "center", "above_text"]
        },
        "params": {
          "type": "object"
        },
        "sound": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "gain"],
          "properties": {
            "asset_id": {
              "$ref": "#/$defs/assetId"
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grind_ink"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": false,
                "properties": {
                  "direction": {
                    "enum": ["cw", "ccw"]
                  },
                  "tone": {
                    "enum": ["pale", "normal", "deep"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "press_seal"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["camera"]
            },
            {
              "required": ["moments"]
            },
            {
              "required": ["sounds"]
            },
            {
              "required": ["effects"]
            },
            {
              "required": ["cgs"]
            },
            {
              "required": ["instruments"]
            },
            {
              "required": ["gestures"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "cues": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": ["grade"]
                  },
                  {
                    "required": ["layout"]
                  },
                  {
                    "required": ["atmosphere"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
